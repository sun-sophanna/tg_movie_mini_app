# Repo root — used by Docker Compose (Local Bot API for videos over 20 MB).
# Copy to .env before: pnpm run docker:telegram-api:up
#
#   cp .env.example .env
#
# Credentials: https://my.telegram.org → API development tools (not BotFather).
# Nest API settings (bot token, TELEGRAM_API_BASE_URL, database) stay in apps/api/.env.

TELEGRAM_API_ID=
TELEGRAM_API_HASH=
