NODE_ENV=development
PORT=3000
API_PREFIX=api

# Option A — Neon (recommended if you have no local Postgres): paste from https://neon.tech
# DATABASE_URL=postgresql://user:password@ep-xxx.region.aws.neon.tech/neondb?sslmode=require

# Option B — local Postgres via Docker (after: pnpm run docker:db:up)
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/telegram_movie?sslmode=disable

DATABASE_URL=

TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_STORAGE_CHAT_ID=

# Files over 20 MB: run Local Bot API (see docs/telegram-local-bot-api.md), then set:
# TELEGRAM_API_BASE_URL=http://localhost:8081
# Public HTTPS URL clients use to stream (required in production; can match API base locally):
# TELEGRAM_FILE_BASE_URL=https://bot-api.yourdomain.com
# TELEGRAM_FILE_REQUEST_TIMEOUT_MS=120000

TELEGRAM_AUTH_MAX_AGE_SECONDS=86400

CACHE_ENABLED=true
CACHE_DEFAULT_TTL_SECONDS=300

CORS_ORIGINS=http://localhost:5173
RATE_LIMIT_TTL_MS=60000
RATE_LIMIT_MAX=100

TELEGRAM_MOCK_AUTH_ENABLED=true
